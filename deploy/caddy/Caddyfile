# Senda Sovereign Search Engine — Caddy Production Reverse Proxy

senda.ideh.top {
    # Automatic Let's Encrypt HTTPS via ACME

    # Sovereign Privacy Headers
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; img-src * data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none';"
        -Server
    }

    # Zero IP Logging
    log {
        output file /var/log/caddy/senda.log
        format filter {
            wrap console
            fields {
                request>remote_ip delete
                request>client_ip delete
            }
        }
    }

    # Reverse proxy to local Uvicorn daemon
    reverse_proxy 127.0.0.1:8000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up -X-Forwarded-For
        header_up X-Forwarded-For "0.0.0.0"
        header_up -X-Real-IP
        header_up X-Real-IP "0.0.0.0"
    }
}
