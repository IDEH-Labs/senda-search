[Unit]
Description=Senda SQLite Database Maintenance and WAL Checkpoint
After=senda.service

[Service]
Type=oneshot
User=senda
Group=senda
ExecStart=/usr/bin/sqlite3 /var/lib/senda/data/senda.db "PRAGMA wal_checkpoint(TRUNCATE); PRAGMA optimize;"
