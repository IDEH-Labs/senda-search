[Unit]
Description=Senda Sovereign Search Background Crawler
After=network.target senda.service

[Service]
Type=oneshot
User=senda
Group=senda
WorkingDirectory=/var/lib/senda
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/senda/venv/bin/senda crawl --seeds-file /etc/senda/ethical_seeds.txt --max-pages 500 --max-depth 2
StandardOutput=journal
StandardError=journal

# Sandboxing & Systemd Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/senda
PrivateTmp=yes
