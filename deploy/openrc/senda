name="senda"
description="Senda Sovereign Search Engine"

: ${SENDA_USER:="senda"}
: ${SENDA_GROUP:="senda"}
: ${SENDA_DIR:="/var/lib/senda"}
: ${SENDA_HOST:="127.0.0.1"}
: ${SENDA_PORT:="8000"}

: ${SENDA_COMMAND:="/opt/senda/venv/bin/senda"}

command="${SENDA_COMMAND}"
command_args="serve --host ${SENDA_HOST} --port ${SENDA_PORT}"
command_user="${SENDA_USER}:${SENDA_GROUP}"
command_background="yes"
pidfile="/run/senda.pid"
directory="${SENDA_DIR}"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -d -m 0750 -o "${SENDA_USER}:${SENDA_GROUP}" "${SENDA_DIR}/data"
}
